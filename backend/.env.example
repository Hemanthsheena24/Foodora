# Copy this file to .env and fill values before running the seeder
MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here

# Usage:
# 1. Copy to .env (in the backend folder):
#    cp .env.example .env   (or create manually on Windows)
# 2. Install dependencies (if not already):
#    npm install
# 3. Run the seeder:
#    node seed.js

# Notes:
# - Do NOT commit real credentials to version control.
# - If you want me to run the seeder here, paste your MONGODB_URI (and optional JWT_SECRET) in the chat.
