# Docker Environment Configuration
# This file contains environment variables for Docker deployment

# MongoDB Configuration
MONGODB_URI=mongodb://admin:password123@mongodb:27017/food_delivery?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=food_delivery

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-docker

# Application Configuration
NODE_ENV=production
PORT=5000

# React App Configuration
REACT_APP_API_URL=http://localhost:5000/api